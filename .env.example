# Set to "true" to use the real backend (ApiAuthStrategy / ApiUserRepository / PrivatBank).
# Set to "false" (default) to run entirely against the local Mock layer - no backend required.
VITE_BACKEND_MODE=false

# Base URL for the real backend API. Only used when VITE_BACKEND_MODE=true.
VITE_API_BASE_URL=/api

# EmailJS credentials (https://www.emailjs.com/) for sending real password-recovery
# emails. If any of these are missing, the app automatically falls back to
# ConsoleEmailService, which logs the code instead of sending an email.
VITE_EMAILJS_SERVICE_ID=service_uem5che
VITE_EMAILJS_TEMPLATE_ID=template_ya8n2gf
VITE_EMAILJS_PUBLIC_KEY=Shbdrej0_7C6_qYUW

# PrivatBank Acquiring API configuration. Only used when VITE_BACKEND_MODE=true
# AND both values below are set; otherwise MockPaymentGateway is used.
VITE_PRIVATBANK_API_BASE_URL=
VITE_PRIVATBANK_MERCHANT_ID=
