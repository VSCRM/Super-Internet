# "true" = talk to the real backend, "false" = local Mock layer (no backend needed).
VITE_BACKEND_MODE=true

# JSON API base. Keep "/api": the Vite dev server proxies it to VITE_BACKEND_ORIGIN.
VITE_API_BASE_URL=/api

# Where the backend runs. Used by the dev proxy AND as the target of the
# "Sign in with Google" redirect (<origin>/oauth2/authorization/google).
VITE_BACKEND_ORIGIN=http://localhost:8080

# Monthly tariff prices in UAH. The backend has no endpoint for them, so they MUST
# match the tariff prices used by the backend.
VITE_PRICE_INTERNET=250
VITE_PRICE_INTERNET_TV=350

# EmailJS credentials (https://www.emailjs.com/) - Mock mode only. With the real backend
# the password-recovery code is sent (or logged) by the backend itself.
VITE_EMAILJS_SERVICE_ID=service_uem5che
VITE_EMAILJS_TEMPLATE_ID=template_ya8n2gf
VITE_EMAILJS_PUBLIC_KEY=Shbdrej0_7C6_qYUW

# Payment mode: "mock" = simulated test payments, "real" = real Privat24 payment through the
# backend (LiqPay; the backend needs LIQPAY_* keys, see README; needs VITE_BACKEND_MODE=true).
# Anything else = mock.
VITE_PAYMENT_MODE=mock

# Test ("mock") cards the payment form accepts - ONLY in VITE_PAYMENT_MODE=mock; ignored in "real".
# Comma-separated (VISA, Mastercard). Any future expiry date and any 3-digit CVV work.
# Empty = any card that passes the format and Luhn checks.
VITE_MOCK_CARDS=4111111111111111,5555555555554444
